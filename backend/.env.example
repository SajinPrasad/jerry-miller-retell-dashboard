DJANGO_SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=postgres://user:pass@localhost:5432/surpro
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# GoHighLevel marketplace app (values from the app's settings in the marketplace)
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_APP_ID=
# Advanced Settings > Auth > Shared Secret. Decrypts the session the embedded admin page gets
# from GHL. Regenerating it in the marketplace invalidates every open page immediately.
GHL_APP_SSO_KEY=
# Verifies the `X-GHL-Signature` header on GHL's webhooks. Not a secret - the same key for every
# marketplace app - so this only needs setting if GHL ever rotates it (default in settings/base.py).
GHL_WEBHOOK_PUBLIC_KEY=
# Jerry's agency location id (stored on the agency row; skipped when syncing clients)
AGENCY_LOCATION_ID=
# The sub-account holding the client contacts and their saved cards. Phase 5 raises its
# invoices here, NOT against AGENCY_LOCATION_ID, which has no contacts in it.
GHL_MAIN_LOCATION_ID=
GHL_BUSINESS_NAME=SurPro Labs AI
# Required by /invoices/{id}/send as sentFrom.fromEmail; GHL rejects the call without either
# this or a userId.
GHL_BUSINESS_EMAIL=billing@surprolabs.ai
GHL_REDIRECT_URI=http://localhost:8000/api/oauth/callback/
# Host of the app's Installation URL; white-label hosts differ
GHL_INSTALL_URL_BASE=https://marketplace.gohighlevel.com
GHL_API_VERSION=2021-07-28

# Must be the Retell API key with the webhook badge (it also verifies webhook signatures)
RETELL_API_KEY=
# per_second (default) or round_up_minute. Applies to Retell only: Twilio's usage records
# already arrive rounded to Twilio's own billed increment.
RETELL_ROUNDING=per_second

# Twilio, for regular call minutes. Must be the PARENT account's SID and Auth Token: a
# main-account API key is denied access to subaccount usage records.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Stripe, for charging clients their monthly voice usage. The secret key of the account the
# bills are charged through, and the signing secret of the webhook endpoint registered against
# /api/rebilling/webhooks/stripe/ - two different secrets.
# Stripe is the FALLBACK rail. GHL invoices are tried first.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# GHL invoices: the primary rail. Needs the invoices.write and invoices.readonly scopes.
# liveMode decides whether an invoice moves real money - left false so nothing charges a
# real card until someone sets it deliberately.
GHL_INVOICE_LIVE_MODE=false
# Hours to wait after a GHL invoice before falling back to Stripe. Below 72 this races
# GHL's own 24-hourly retries and double-charges the client.
BILLING_FALLBACK_WINDOW_HOURS=72

REDIS_URL=redis://localhost:6379/0
