DJANGO_SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=postgres://user:pass@localhost:5432/surpro
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# GoHighLevel marketplace app (values from the app's settings in the marketplace)
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_APP_ID=
# Advanced Settings > Auth > Shared Secret. Decrypts the session the embedded admin page gets
# from GHL. Regenerating it in the marketplace invalidates every open page immediately.
GHL_APP_SSO_KEY=
# Verifies the `X-GHL-Signature` header on GHL's webhooks. Not a secret - the same key for every
# marketplace app - so this only needs setting if GHL ever rotates it (default in settings/base.py).
GHL_WEBHOOK_PUBLIC_KEY=
# Jerry's agency location id (stored on the agency row; skipped when syncing clients)
AGENCY_LOCATION_ID=
GHL_REDIRECT_URI=http://localhost:8000/api/oauth/callback/
# Host of the app's Installation URL; white-label hosts differ
GHL_INSTALL_URL_BASE=https://marketplace.gohighlevel.com
GHL_API_VERSION=2021-07-28

# No Retell API key here: each client has their own Retell workspace, and its key is pasted
# into the admin page and stored encrypted. It must be the workspace's key carrying the
# webhook badge - the same key is what verifies that workspace's webhook signatures.
# per_second (default) or round_up_minute. Applies to Retell only: Twilio's usage records
# already arrive rounded to Twilio's own billed increment.
RETELL_ROUNDING=per_second

# Twilio, for regular call minutes. Must be the PARENT account's SID and Auth Token: a
# main-account API key is denied access to subaccount usage records.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Stripe, for charging clients their monthly voice usage. The secret key of the account the
# bills are charged through, and the signing secret of the webhook endpoint registered against
# /api/rebilling/webhooks/stripe/ - two different secrets.
# This must be the SAME Stripe account GoHighLevel is connected to. A client is matched to a
# Stripe customer by the email of their GHL sub-account owner, and the saved card is on the
# customer GHL already created there - point this at another account and every bill fails with
# "No Stripe customer found for billing email: ...".
STRIPE_SECRET_KEY=
# Bill Twilio regular call minutes. Off: GoHighLevel rebills them natively, so billing them here
# too would charge the client twice. Usage is still pulled and stored while this is off.
TWILIO_BILLING_ENABLED=False
# Retries after a declined charge: how many, and how many hours apart.
BILLING_MAX_RETRIES=3
BILLING_RETRY_INTERVAL_HOURS=12
# Placeholders until the fields exist: the ids of the rebilling status and card status custom
# fields on the billing contacts in the main sub-account, and the shared secret the GoHighLevel
# workflow sends back when a card has been entered.
GHL_RETELL_STATUS_CUSTOM_FIELD_ID=
GHL_CARD_STATUS_CUSTOM_FIELD_ID=
GHL_CARD_WEBHOOK_TOKEN=
STRIPE_WEBHOOK_SECRET=

REDIS_URL=redis://localhost:6379/0
